[Unit]
Description=Antigravity-Proxy Multi-Protocol Gateway
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/antigravity-proxy
ExecStart=/home/ubuntu/antigravity-proxy/antigravity-proxy -config /home/ubuntu/antigravity-proxy/config.json
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
